{
  "buildCommand": "npm run build",
  "outputDirectory": "_site",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/jetterix-pressure-nozzle-review",
      "destination": "/cleaning/garden-hose-pressure-nozzle/",
      "permanent": true
    },
    {
      "source": "/jetterix-pressure-nozzle-review/",
      "destination": "/cleaning/garden-hose-pressure-nozzle/",
      "permanent": true
    },
    {
      "source": "/katori-titanium-cutting-board-review",
      "destination": "/kitchen/do-titanium-cutting-boards-dull-knives/",
      "permanent": true
    },
    {
      "source": "/katori-titanium-cutting-board-review/",
      "destination": "/kitchen/do-titanium-cutting-boards-dull-knives/",
      "permanent": true
    },
    {
      "source": "/facelessforge",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/facelessforge/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/facelessforge/bundle",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/facelessforge/bundle/",
      "destination": "/",
      "permanent": true
    }
  ]
}
